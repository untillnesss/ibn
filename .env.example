# Base URL of the Laravel upload backend (see backend/ folder).
VITE_API_URL=http://127.0.0.1:8000

# Must match UPLOAD_API_KEY in backend/.env exactly. This is baked into
# the built static bundle in plaintext — it's abuse-deterrence only
# (this app has no real authentication anywhere), not real access control.
VITE_UPLOAD_API_KEY=
